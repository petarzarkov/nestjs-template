# E2E Test Environment Configuration

# API endpoints (the app-under-test must be running here)
E2E_API_URL=http://localhost:3011
E2E_WS_URL=ws://localhost:3011/ws

# Test defaults
E2E_TEST_PASSWORD=Test123$

# SQLite file the test DbClient uses for setup/verification.
# Start the app-under-test with the SAME SQLITE_DB_PATH so they share data.
SQLITE_DB_PATH=./.tmp/e2e.db
