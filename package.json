{
  "name": "nestjs-template",
  "version": "0.1.0",
  "private": true,
  "description": "A production-ready, SQLite-first NestJS monolith template on Bun — Drizzle ORM, bullmq + Redis, and modern tooling.",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov/"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "dev": "bun --watch src/main.ts",
    "dev:nest": "nest start --watch --exec bun",
    "start": "bun dist/main.js",
    "build": "bun ./scripts/build.ts",
    "gen:env:docs": "bun ./scripts/gen-env-docs.ts",
    "test": "bun scripts/test.ts -- 'src/**/*.test.ts' 'src/**/*.int.ts'",
    "test:watch": "bun test --watch",
    "test:cov": "bun scripts/test.ts --coverage -- 'src/**/*.test.ts' 'src/**/*.int.ts'",
    "test:unit": "bun scripts/test.ts -- 'src/**/*.test.ts'",
    "test:int": "bun scripts/test.ts -- 'src/**/*.int.ts'",
    "test:e2e": "bun scripts/test.ts --env-file=./e2e/.env --preload ./e2e/setup/preload.ts -- 'e2e/**/*.e2e.ts'",
    "test:e2e:single": "bun test --timeout 30000 --env-file=./e2e/.env --preload ./e2e/setup/preload.ts --bail",
    "email": "bunx react-email@6.9.1 dev --dir src/notifications/email/templates --port 3035",
    "email:export": "bunx react-email@6.9.1 export --dir src/notifications/email/templates",
    "lint": "oxlint --type-aware --fix src e2e scripts",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "mig:gen": "bun --env-file=.env drizzle-kit generate",
    "mig:run": "bun --env-file=.env drizzle-kit migrate",
    "db:push": "bun --env-file=.env drizzle-kit push",
    "db:studio": "bun --env-file=.env drizzle-kit studio",
    "db:drop": "bun run ./scripts/db-drop.ts",
    "seed": "bun --env-file=.env ./scripts/seed.ts",
    "create:admin": "bun --env-file=.env ./scripts/create-admin.ts",
    "mod:cost": "bunx @arkv/module-cost"
  },
  "dependencies": {
    "@arkv/nestjs-cms": "^0.3.4",
    "@arkv/nestjs-context-logger": "^0.3.4",
    "@arkv/shared": "^0.7.2",
    "@aws-sdk/client-s3": "3.1094.0",
    "@bull-board/api": "8.3.0",
    "@bull-board/express": "8.3.0",
    "@bull-board/nestjs": "8.3.0",
    "@google/genai": "^2.13.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@react-email/components": "1.0.12",
    "@scalar/nestjs-api-reference": "1.2.11",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.25",
    "bullmq": "5.81.1",
    "cache-manager": "7.2.9",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "ioredis": "5.11.1",
    "mime-types": "3.0.2",
    "nestjs-zod": "^5.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "resend": "6.18.0",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@react-email/ui": "6.9.1",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "inquirer": "14.0.2",
    "lint-staged": "17.2.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "socket.io-client": "4.8.3",
    "typescript": "7.0.2"
  }
}
