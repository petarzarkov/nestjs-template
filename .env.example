# Application
APP_ENV=local # The current application environment (e.g., dev, stage, prod).
NODE_ENV=development # The current service environment (e.g., development, staging, production).
API_PORT=3011

# Logging
LOG_LEVEL='debug' # Sets the minimum log level (VERBOSE, DEBUG, LOG, WARN, ERROR, FATAL)
LOG_MASK_FIELDS='accessToken,jwt,password,secret,phone' # Comma-separated list of fields to mask in logs
LOG_FILTER_EVENTS='/api/service/health,/api/service/config,/api/service/up,/api/queues' # Comma-separated list of events to fully exclude from logging e.g. '/api/service/health'
LOG_MAX_ARRAY_LENGTH=1 # Maximum number of array items to include in logs before truncating

# SWAGGER_TOKEN=6189fe54e9b4 # (optional) Token to protect the Swagger API documentation UI.

# Security & Authentication (Better Auth)
BETTER_AUTH_SECRET=dalfkko42fo2fok24fo2f4k0fsfd # Secret Better Auth uses to sign sessions/tokens. Use a long random string in production.
AUTH_SESSION_EXPIRATION=86400 # Session lifetime in seconds — max idle age before a session expires (default 86400 = 1 day).
AUTH_SESSION_UPDATE_AGE=3600 # Rolling-refresh window in seconds — an active session past this age is extended to now + expiration (default 3600 = 1 hour). Must be <= AUTH_SESSION_EXPIRATION.

# Database — SQLite by default (no external service needed)
DB_TYPE=sqlite                                   # sqlite | postgres (postgres reserved for a future async data layer)
SQLITE_DB_PATH=./data/app.db                     # SQLite file (auto-created; migrations applied on boot)
# --- PostgreSQL (only read when DB_TYPE=postgres) ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5438
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=pgdb
# POSTGRES_USE_SSL=false
# POSTGRES_CA_PATH=/path/to/ca-certificate.crt   # Required if POSTGRES_USE_SSL=true

# Redis — powers the BullMQ queue, Socket.io adapter, throttler storage, and REST cache
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0                                       # Base DB (queue). Cache/throttler/sockets use dedicated DBs (3/2/4)
REDIS_CACHE_TTL=5000                             # REST cache TTL in ms (1000-60000)
REDIS_QUEUES_CONCURRENCY=3                        # Jobs processed concurrently per queue (1-100)
REDIS_QUEUES_MAX_RETRIES=3                        # Retry attempts for failed jobs (1-10)
REDIS_QUEUES_RETRY_DELAY_MS=5000                  # Base retry delay in ms (exponential backoff)
REDIS_QUEUES_JOB_TIMEOUT_MS=120000               # Per-job execution timeout in ms
REDIS_QUEUES_RATE_LIMIT_MAX=100                   # Max jobs per rate window
REDIS_QUEUES_RATE_LIMIT_DURATION=1000            # Rate window in ms

# HTTP Client Configuration
HTTP_REQ_TIMEOUT=10000 # The timeout for outgoing HTTP requests, in milliseconds.
HTTP_REQ_MAX_REDIRECTS=5 # The maximum number of redirects to follow for an HTTP request.

CORS_ORIGIN='*' # wildcard for dev

# Email Config
EMAIL_API_KEY=testestsetst # Your API key for the service.
EMAIL_SENDER='App Dev <dev@resend.dev.com>' # The "From" address for outgoing emails.
EMAIL_ADMIN=admin@dev.com

# Websocket Config
WS_PATH=/ws
WS_TRANSPORTS='websocket'

TZ=UTC

# OAuth2 (optional) — Better Auth runs the flow; you only set client id + secret.
# It derives the redirect/callback URL as <base>/api/auth/callback/<provider>,
# where <base> is WEB_URL (or http://localhost:${API_PORT} when unset). Register
# these in each provider dashboard:
#   Google:   <base>/api/auth/callback/google
#   GitHub:   <base>/api/auth/callback/github
#   LinkedIn: <base>/api/auth/callback/linkedin
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id # Your Google OAuth client ID.
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret # Your Google OAuth client secret.
GITHUB_OAUTH_CLIENT_ID=your_github_client_id # Your GitHub OAuth client ID.
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret # Your GitHub OAuth client secret.
LINKEDIN_OAUTH_CLIENT_ID=your_linkedin_client_id # Your LinkedIn OAuth client ID.
LINKEDIN_OAUTH_CLIENT_SECRET=your_linkedin_client_secret # Your LinkedIn OAuth client secret

# AI (optional)
AI_GEMINI_API_KEY=your_gemini_api_key
AI_GROQ_API_KEY=your_groq_api_key
AI_OPENROUTER_API_KEY=your_openrouter_api_key
AI_STREAM_TIMEOUT=10000
AI_DEFAULT_TEMPERATURE=0.9

# AWS File Storage
AWS_S3_BUCKET_NAME=dev-test
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=awsaccesskeyid # Optional, can be used for local dev testing
AWS_SECRET_ACCESS_KEY=awssecretaccesskey # Optional, can be used for local dev testing

